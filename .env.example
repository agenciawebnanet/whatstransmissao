# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WhatsTransmissão License Security Variables (Required on Vercel & Production)
# HMAC_SECRET: Secret key for signing offline HMAC tokens (fail-fast if missing)
HMAC_SECRET="your_hmac_secret_key"

# FIREBASE_SERVICE_ACCOUNT: Firebase Service Account JSON string or Base64 (fail-fast if missing)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"gen-lang-client-0919034007",...}'

# Optional Project ID
FIREBASE_PROJECT_ID="gen-lang-client-0919034007"
